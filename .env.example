DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
MONGO_URI=your_mongodb_connection_string_here
PORT=3001
OLD_MONGO_URI=your_old_mongodb_connection_string_here

# Gemini API Keys (copied from Furina or Google AI Studio)
GEMINI_1_KEY=your_gemini_api_key_1
GEMINI_1_PROJECT=your_google_cloud_project_id_1
GEMINI_1_PROJECT_NUMBER=your_google_cloud_project_number_1
GEMINI_2_KEY=your_gemini_api_key_2
GEMINI_2_PROJECT=your_google_cloud_project_id_2
GEMINI_2_PROJECT_NUMBER=your_google_cloud_project_number_2

# Gemini reliability limits for a small private bot
GEMINI_MAX_IN_FLIGHT=3
GEMINI_MAX_PAIR_IN_FLIGHT=1
GEMINI_MAX_API_ATTEMPTS=3
